public class FireWeapon extends WeaponDecorator{

    public FireWeapon(WeaponBehavior wrapped) {
        super(wrapped);
    }

    @Override
    public int damage(){
        return wrapped.damage() + 4;
    }

    @Override
    public String description() {
        return wrapped.description() + " +  fire";
    }
}


public class PowerWeapon extends WeaponDecorator {

    public PowerWeapon(WeaponBehavior wrapped){
        super(wrapped);
    }

    @Override
    public int damage() {
        return wrapped.damage() * 2;
    }

    @Override
    public String description() {
        return wrapped.description() + " x2 ";
    }
}
